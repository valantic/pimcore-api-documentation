{
  "name": "valantic/pimcore-api-documentation",
  "version": "0.6.6",
  "description": "Auto generate API documentation for routes",
  "homepage": "https://github.com/valantic/pimcore-api-documentation",
  "license": "MIT",
  "authors": [
    {
      "name": "Dino Turopoli",
      "email": "dino.turopoli@factory.dev"
    },
    {
      "name": "Linus Metzler",
      "email": "linus.metzler@cec.valantic.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Valantic\\PimcoreApiDocumentationBundle\\": "src/"
    }
  },
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "pimcore/pimcore": "^12.0",
    "nelmio/api-doc-bundle": "^5.0",
    "nikic/php-parser": "^5.0",
    "phpstan/phpdoc-parser": "^2.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.92.5",
    "phpstan/extension-installer": "^1.4.3",
    "phpstan/phpstan": "^2.1.33",
    "phpstan/phpstan-deprecation-rules": "^2.0.3",
    "phpstan/phpstan-strict-rules": "^2.0.7",
    "rector/rector": "^2.3",
    "roave/security-advisories": "dev-latest",
    "valantic/php-cs-fixer-config": "^2.2.1"
  },
  "scripts": {
    "post-update-cmd": [
      "@composer bump -D"
    ],
    "rector": [
      "./vendor/bin/rector process"
    ],
    "phpstan": [
      "vendor/bin/phpstan analyse --memory-limit=1G"
    ],
    "php-cs-fixer": [
      "vendor/bin/php-cs-fixer fix -v --diff"
    ],
    "php-cs-fixer-check": [
      "vendor/bin/php-cs-fixer fix --diff --dry-run"
    ]
  },
  "prefer-stable": false,
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true,
      "php-http/discovery": true
    }
  }
}
